{
  "name": "atlas-health-city",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-demo.mjs",
    "start": "vite",
    "prestart": "node scripts/generate-demo.mjs",
    "build": "node scripts/generate-demo.mjs && vite build",
    "preview": "vite preview",
    "test": "npm run build:package && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build:package": "node scripts/build-city-package.mjs",
    "pack:package": "npm pack ./packages/city-chart",
    "test:package": "npm run build:package && node --test tests/city-package.test.mjs",
    "pretest:e2e": "npm run build:package",
    "audit:contrast": "node scripts/audit-city-contrast.mjs"
  },
  "dependencies": {
    "@tanstack/charts": "1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "0.180.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}

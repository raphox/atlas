{
  "name": "atlas-health-city",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run build:package && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build:package": "node scripts/build-city-package.mjs",
    "pack:package": "npm pack ./packages/city-chart",
    "test:package": "npm run build:package && node --test tests/city-package.test.mjs",
    "pretest:e2e": "npm run build:package",
    "audit:contrast": "node scripts/audit-city-contrast.mjs",
    "dev:docs": "vite --config vite.docs.config.js",
    "build:docs": "vite build --config vite.docs.config.js",
    "preview:docs": "vite preview --config vite.docs.config.js",
    "test:docs": "npm run build:docs && playwright test --config playwright.docs.config.js"
  },
  "dependencies": {
    "@tanstack/charts": "1.1.0",
    "lucide-react": "^1.59.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-live": "^5.0.1",
    "react-simple-code-editor": "^0.14.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
